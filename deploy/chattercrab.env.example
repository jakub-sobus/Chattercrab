CHATTERCRAB_BIND=0.0.0.0:8443
CHATTERCRAB_TLS_CERT=/etc/chattercrab/tls/fullchain.pem
CHATTERCRAB_TLS_KEY=/etc/chattercrab/tls/privkey.pem
CHATTERCRAB_TURN_SECRET=__GENERATED_BY_INSTALL_SH__
CHATTERCRAB_TURN_REALM=chat.example.com
CHATTERCRAB_TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp,turns:chat.example.com:5349?transport=tcp
CHATTERCRAB_MAX_ROOM_SIZE=5
CHATTERCRAB_MAX_ROOMS=100
CHATTERCRAB_ROOM_IDLE_TTL_SECS=3600
RUST_LOG=info,chattercrab_server=info
